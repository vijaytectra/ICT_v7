# ---------------------------------------------------------------- market data
# Dukascopy 1-minute bid/ask history and the broker M15 dumps.  Licensed data,
# hundreds of megabytes, and re-derivable: engine/load.py rebuilds the parquets from
# the CSV exports, models/screen_broker.py re-dumps the broker bars from MT5.
data/
*.parquet

# ------------------------------------------------------- third-party reference repos
# Cloned for research only.  Each carries its own git history and licence; they are
# not ours to redistribute.  Clone list is in REFERENCES.md.
ref_new/
ref_brodenbeck/
ref_srsblack/
OpenMobius-skill/

# ------------------------------------------------------------------ heavy artefacts
# Per-minute excursion path stores and signal caches.  Regenerated by
# models/asia_paths.py, models/uni_prep.py and models/screen_broker.py.
reports/*.pkl
*.ex5
*.log

